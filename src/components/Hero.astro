---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  headlinePrefix: string
  headlineAccent: string
  description: string
  primaryCta: { label: string; href: string }
  secondaryCta: { label: string; href: string }
  image: { src: ImageMetadata; alt: string }
}

const {
  headlinePrefix,
  headlineAccent,
  description,
  primaryCta,
  secondaryCta,
  image,
} = Astro.props
---

<section class="hero relative min-h-[80vh] overflow-hidden bg-neutral text-neutral-content">
  <!-- Background image -->
  <Image
    src={image.src}
    alt={image.alt}
    width={1920}
    widths={[960, 1440, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 w-full h-full object-cover"
  />

  <!-- Gradient overlay: dark on left where text sits, fades right -->
  <div class="hero-overlay absolute inset-0 bg-transparent bg-linear-to-r from-neutral/90 via-neutral/75 to-neutral/40"></div>

  <div class="hero-content block relative z-10 w-full container mx-auto px-4 py-16">
    <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold leading-tight">
      {headlinePrefix}<br />
      <span class="underline decoration-primary decoration-4 underline-offset-8">{headlineAccent}</span>
    </h1>
    <p class="text-lg mt-4 mb-8 max-w-lg">{description}</p>
    <div class="flex gap-4 flex-wrap">
      <a href={primaryCta.href} class="btn btn-primary rounded-full">{primaryCta.label}</a>
      <a href={secondaryCta.href} class="btn btn-outline rounded-full text-neutral-content hover:bg-neutral-content hover:text-neutral focus-visible:bg-neutral-content focus-visible:text-neutral">{secondaryCta.label}</a>
    </div>
  </div>
</section>
